@page
@model ElectricityTradingPortal.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}

@if (Model.Drafts.Count > 0)
{
    <h2 class="section-title">Your Drafts</h2>
    <table class="orders-table">
        <thead>
            <tr>
                <th>Trader</th>
                <th>Commodity</th>
                <th>Side</th>
                <th class="numeric">Volume (MWh)</th>
                <th class="numeric">Price/MWh</th>
                <th class="numeric">Value</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var draft in Model.Drafts)
            {
                <tr>
                    <td>@draft.Trader</td>
                    <td>@draft.Commodity</td>
                    <td><span class="badge badge-@draft.Side.ToString().ToLower()">@draft.Side</span></td>
                    <td class="numeric">@draft.Volume.ToString("N2")</td>
                    <td class="numeric">@draft.Price.ToString("N2")</td>
                    <td class="numeric">@draft.Value.ToString("C")</td>
                    <td><a asp-page="/Orders/Create" asp-route-draft="@draft.Id">Continue editing</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<h1>Submitted Orders</h1>

<p class="muted">Orders below the trading limit that have been submitted to the market.</p>

@if (Model.Orders.Count == 0)
{
    <p class="empty-state">No submitted orders yet. <a asp-page="/Orders/Create">Submit your first order</a>.</p>
}
else
{
    <table class="orders-table">
        <thead>
            <tr>
                <th>Trader</th>
                <th>Commodity</th>
                <th>Side</th>
                <th class="numeric">Volume (MWh)</th>
                <th class="numeric">Price/MWh</th>
                <th class="numeric">Value</th>
                <th>Submitted (UTC)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.Trader</td>
                    <td>@order.Commodity</td>
                    <td><span class="badge badge-@order.Side.ToString().ToLower()">@order.Side</span></td>
                    <td class="numeric">@order.Volume.ToString("N2")</td>
                    <td class="numeric">@order.Price.ToString("N2")</td>
                    <td class="numeric">@order.Value.ToString("C")</td>
                    <td>@order.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><a asp-page="/Orders/Details" asp-route-id="@order.Id">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}